const CTA_VARIATIONS: ((city: string, serviceName: string, phone: string) => { heading: string; subtext: string })[] = [
  (city, svc, phone) => ({
    heading: `${city} homeowners: get your free ${svc.toLowerCase()} estimate today`,
    subtext: `Call ${phone} — we answer 24/7, even weekends and holidays.`,
  }),
  (city, svc, phone) => ({
    heading: `${city}'s most trusted remodeling team is ready for your project`,
    subtext: `${BUSINESS.projectsCompleted} projects completed. Book your free consultation: ${phone}`,
  }),
  (city, svc, phone) => ({
    heading: `Your neighbors in ${city} already chose us. See why`,
    subtext: `${BUSINESS.rating} stars from ${BUSINESS.reviewCount}+ reviews. Free estimates: ${phone}`,
  }),
  (city, svc, phone) => ({
    heading: `This month: free design consultation for ${city} homeowners`,
    subtext: `Limited availability. Lock in your spot — call ${phone} now.`,
  }),
  (city, svc, phone) => ({
    heading: `Stop putting off your ${svc.toLowerCase()} project`,
    subtext: `${city} homeowners get same-day estimates. ${BUSINESS.warranty} warranty included. ${phone}`,
  }),
  (city, svc, phone) => ({
    heading: `Ready to transform your ${city} home?`,
    subtext: `We respond ${BUSINESS.responseTime.toLowerCase()}. ${BUSINESS.warranty} warranty on every project. ${phone}`,
  }),
  (city, svc, phone) => ({
    heading: `Don't settle for less than the best ${svc.toLowerCase()} in ${city}`,
    subtext: `Licensed, bonded, insured. ${BUSINESS.experience} years. Free quotes: ${phone}`,
  }),
  (city, svc, phone) => ({
    heading: `Your dream home upgrade is closer than you think`,
    subtext: `${city} homeowners save thousands with our expert team. Call ${phone} for your free estimate.`,
  }),
];

