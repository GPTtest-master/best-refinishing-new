// ============================================
// COST MULTIPLIER (derived from Census median home values)
// Seattle = baseline (1.0), others scaled proportionally
// ============================================

function getCityMultiplier(cityId: string): number {
  const seattleValue = CITY_CENSUS_DATA['seattle']?.medianHomeValue || 879900;
  const cityValue = CITY_CENSUS_DATA[cityId]?.medianHomeValue;
  if (!cityValue) return 1.0;
  const raw = cityValue / seattleValue;
  return Math.max(0.7, Math.min(1.8, Math.round(raw * 100) / 100));
}

function adjustPriceRange(range: string, multiplier: number): string {
  const matches = range.match(/\$([\d,]+)\s*[\u2013\u2014\u2212–—-]\s*\$([\d,]+)/);
  if (!matches) return range;
  const low = parseInt(matches[1].replace(/,/g, ''), 10);
  const high = parseInt(matches[2].replace(/,/g, ''), 10);
  const adjLow = Math.round((low * multiplier) / 100) * 100;
  const adjHigh = Math.round((high * multiplier) / 100) * 100;
  return '$' + adjLow.toLocaleString('en-US') + ' – $' + adjHigh.toLocaleString('en-US');
}

function formatDollars(n: number): string {
  if (n >= 1000000) return `${(n / 1000000).toFixed(1)}M`;
  return `${Math.round(n / 1000)}K`;
}

function getCensusInsight(cityName: string, cityId: string, serviceName: string): string {
  const census = CITY_CENSUS_DATA[cityId];
  if (!census) return '';
  const homeVal = formatDollars(census.medianHomeValue);
  const income = formatDollars(census.medianIncome);
  const svcLower = serviceName.toLowerCase();
  const multiplier = getCityMultiplier(cityId);
  const typicalBudget = multiplier > 1.1 ? 'premium-tier' : multiplier < 0.9 ? 'value-conscious' : 'mid-range';

  const variations = [
    `With a median home value of ${homeVal} in ${cityName}, quality ${svcLower} is one of the smartest investments homeowners can make. At a median household income of ${income}, most ${cityName} families budget for ${typicalBudget} finishes that protect their property value.`,
    `${cityName} homes have a median value of ${homeVal} (US Census 2022), and homeowners here typically invest in ${typicalBudget} ${svcLower} projects. With median household income at ${income}, our pricing is designed to match what ${cityName} families expect.`,
    `Census data shows ${cityName}'s ${census.population.toLocaleString()} residents have a median household income of ${income} and median home values of ${homeVal}. This means ${svcLower} projects here trend toward ${typicalBudget} specifications and materials.`,
    `${cityName}'s median home value of ${homeVal} makes professional ${svcLower} a smart equity play. With household incomes averaging ${income}, homeowners in this market typically choose materials and finishes that match their home's value bracket.`,
  ];
  return variations[hashString(cityId + serviceName + 'census') % variations.length];
}

function getKeywordInsight(cityId: string): string {
  const kws = CITY_KEYWORD_VOLUMES[cityId];
  if (!kws || kws.length === 0) return '';
  const top = kws.slice(0, 3);
  const items = top.map(k => `${k.keyword} (${k.volume} monthly searches)`).join(', ');
  return `Most searched remodeling services in this area: ${items}.`;
}

