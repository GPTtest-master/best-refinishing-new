  'edmonds': { population: '42,470', neighborhoods: ['Bowl', 'Perrinville', 'Westgate', 'Firdale', 'Esperance'], avgHomeAge: '45-60 years', housingNote: 'waterfront community where bathroom and kitchen upgrades boost resale' },
};

function getCityContextSentence(cityName: string, cityId: string, serviceName: string, seed: string): string {
  const data = COMBO_CITY_DATA[cityId];
  if (!data) {
    // Fallback for cities without specific data
    return `Serving ${cityName} and surrounding communities with professional ${serviceName.toLowerCase()}. Local homeowners trust us for quality workmanship and lasting results.`;
  }

  const contextVariations = [
    `Serving ${data.neighborhoods[0]}, ${data.neighborhoods[1]}, and surrounding ${cityName} neighborhoods. With a population of ${data.population}, ${cityName} homeowners trust us for quality remodeling and refinishing.`,
    `From ${data.neighborhoods[0]} to ${data.neighborhoods[2]}, we've completed projects throughout ${cityName} (pop. ${data.population}). ${data.avgHomeAge ? `Many local homes are ${data.avgHomeAge} old — ` : ''}perfect candidates for professional ${serviceName.toLowerCase()}.`,
    `${cityName} is home to ${data.population} residents across neighborhoods like ${data.neighborhoods[0]}, ${data.neighborhoods[1]}, and ${data.neighborhoods[3] || data.neighborhoods[2]}. ${data.housingNote ? `Known for ${data.housingNote}, t` : 'T'}his community values quality craftsmanship.`,
    `We're proud to serve ${cityName}'s ${data.population} residents. Whether you're in ${data.neighborhoods[0]} or ${data.neighborhoods[data.neighborhoods.length - 1]}, our team brings the same dedication to every ${serviceName.toLowerCase()} project.`,
    `${cityName} (population ${data.population}) is one of our most active service areas. Homeowners in ${data.neighborhoods[1]}, ${data.neighborhoods[2]}, and beyond choose us for ${serviceName.toLowerCase()} that stands the test of time.`,
    `Trusted by homeowners across ${cityName}'s diverse neighborhoods — from ${data.neighborhoods[0]} to ${data.neighborhoods[3] || data.neighborhoods[2]}. ${data.avgHomeAge ? `With homes averaging ${data.avgHomeAge} old, ` : ''}professional remodeling makes a real difference here.`,
    `Our ${cityName} service area covers ${data.neighborhoods[0]}, ${data.neighborhoods[1]}, ${data.neighborhoods[2]}, and more. ${data.housingNote ? `As a community known for ${data.housingNote}, ` : ''}residents here appreciate top-quality ${serviceName.toLowerCase()}.`,
    `${data.population} people call ${cityName} home — and hundreds of them have trusted us with their ${serviceName.toLowerCase()} projects. From ${data.neighborhoods[0]} to ${data.neighborhoods[2]}, we know this area.`,
    `We've been transforming kitchens and bathrooms across ${cityName} for years. Neighborhoods like ${data.neighborhoods[0]} and ${data.neighborhoods[1]} are where you'll find some of our best work — and our happiest customers.`,
    `${cityName} homeowners in ${data.neighborhoods[0]}, ${data.neighborhoods[1]}, ${data.neighborhoods[2]}, and surrounding areas trust our team for reliable, high-quality ${serviceName.toLowerCase()}.`,
  ];

  return pickVariation(contextVariations, seed + 'cityctx');
}

