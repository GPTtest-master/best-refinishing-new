  'seattle': 'Seattle DCI permits typically take 2-4 weeks for residential remodels.',
  'bellevue': 'Bellevue residential permits are usually processed within 1-2 weeks.',
  'tacoma': 'Tacoma permit processing runs 1-3 weeks for standard bathroom/kitchen work.',
  'redmond': 'Redmond building permits for interior remodels average 1-2 weeks.',
  'kirkland': 'Kirkland residential permits are generally approved within 1-2 weeks.',
  'renton': 'Renton processes most residential remodel permits in 1-2 weeks.',
  'kent': 'Kent building permits for interior renovations take approximately 1-2 weeks.',
  'federal-way': 'Federal Way permits for residential work are typically 1-2 weeks.',
  'bothell': 'Bothell permit timelines run 1-2 weeks for standard interior projects.',
  'lynnwood': 'Lynnwood residential permits are processed in about 1-2 weeks.',
  'issaquah': 'Issaquah permits for residential remodels average 1-2 weeks.',
  'sammamish': 'Sammamish residential permits typically take 2-3 weeks due to critical area reviews.',
  'shoreline': 'Shoreline permit processing averages 1-2 weeks for interior renovations.',
  'burien': 'Burien residential remodel permits are usually ready within 1-2 weeks.',
  'edmonds': 'Edmonds permits for interior renovations are processed in about 1-2 weeks.',
};


// ============================================
// MAIN EXPORT FUNCTION
// ============================================

export interface LocationServiceContent {
  // Meta
  title: string;
  metaDescription: string;
  h1: string;

  // Content
  heroText: string;
  description: string;
  whyChoose: string;
  cityContext: string;
  cityDataContext: string;

  // Lists
  benefits: string[];
  problems: string[];
  process: string[];

  // FAQ
  faqs: { question: string; answer: string }[];
  faqSchema: { '@type': 'FAQPage'; mainEntity: { '@type': 'Question'; name: string; acceptedAnswer: { '@type': 'Answer'; text: string } }[] };

  // Reviews
  reviews: { name: string; rating: number; text: string; date: string }[];

  // Service info
  serviceName: string;
  serviceShortName: string;
  price: string;

  // Cost breakdown, inclusions, timeline, CTA, nearby
  pricingTiers: { tier: string; range: string; description: string }[];
  inclusions: string[];
  timeline: { phase: string; duration: string; detail: string }[];
  permitNote: string;
  warrantyLine: string;
  pricingDisclaimer: string;
  ctaVariation: { heading: string; subtext: string };
  nearbyCityIds: string[];

  // City-specific unique content
  localExpertise: string;
  localFacts: string[];
  censusInsight: string;
  keywordInsight: string;
  sectionOrder: number[];
  censusData: { population: number; medianHomeValue: number; medianIncome: number } | null;


  // Housing data report fields
  housingInsight: string;
  housingStats: string;
  searchTrend: { peak: string; peakVolume: number; low: string; lowVolume: number } | null;
  marketInsight: string;
}

export function getLocationServiceContent(
  cityName: string,
  cityId: string,
  serviceSlug: string,
  servicePrice: string
): LocationServiceContent {
  const service = serviceData[serviceSlug];
  if (!service) {
    throw new Error(`Unknown service: ${serviceSlug}`);
  }

  const seed = cityId + serviceSlug;

  // Pick variations using deterministic hash
  const heroText = pickVariation(service.heroVariations, seed + 'hero')(cityName);
  const description = pickVariation(service.descriptionVariations, seed + 'desc')(cityName);
  const benefits = pickVariation(service.benefitsVariations, seed + 'benefits');
  const problems = pickVariation(service.problemsVariations, seed + 'problems');
  const process = pickVariation(service.processVariations, seed + 'process');
  const faqSet = pickVariation(service.faqVariations, seed + 'faq');
  const whyChoose = pickVariation(whyChooseVariations, seed + 'why')(cityName, service.name);
  const cityContext = pickVariation(cityContextVariations, seed + 'context')(cityName);

  // City-specific context with population and neighborhoods
  const cityDataContext = getCityContextSentence(cityName, cityId, service.name, seed);

  const faqs = faqSet.map(f => ({
    question: f.q,
    answer: f.a(cityName),
  }));

  // FAQPage schema (JSON-LD ready)
  const faqSchema = {
    '@type': 'FAQPage' as const,
    mainEntity: faqs.map(f => ({
      '@type': 'Question' as const,
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer' as const,
        text: f.answer,
      },
    })),
  };

  const reviews = generateReviews(cityName, serviceSlug, service.name);

  // --- Title variations (FIX 5) ---
  const titleVariations = [
    `${service.name} in ${cityName}, WA | ${BUSINESS.name}`,
    `${service.name} in ${cityName}, WA | ${servicePrice} | ${BUSINESS.name}`,
    `${cityName} ${service.name} | ${BUSINESS.rating}\u2605 Rated | Free Estimates`,
    `Professional ${service.name} ${cityName} WA | ${BUSINESS.warranty} Warranty`,
    `${service.name} ${cityName} \u2014 Licensed Contractors | ${BUSINESS.phone}`,
    `${cityName}, WA ${service.name} | ${BUSINESS.experience} Years Experience`,
    `Best ${service.name} in ${cityName} | ${BUSINESS.rating}\u2605 | ${BUSINESS.name}`,
    `${service.name} Services in ${cityName}, WA | Free Quote: ${BUSINESS.phone}`,
  ];
  const title = pickVariation(titleVariations, seed + 'title');

  // --- Meta description variations (FIX 1) ---
  const svcLower = service.name.toLowerCase();
  const metaVariations = [
    `Expert ${svcLower} in ${cityName}, WA. ${BUSINESS.rating}\u2605 rated, ${BUSINESS.projectsCompleted} projects. ${BUSINESS.warranty} warranty. Free estimates: ${BUSINESS.phone}`,
    `${cityName}'s trusted ${svcLower} contractors. Licensed & insured. ${BUSINESS.projectsCompleted} homes transformed. Call ${BUSINESS.phone}`,
    `Top-rated ${svcLower} in ${cityName}, WA. ${servicePrice}. ${BUSINESS.warranty} warranty included. Schedule free consultation: ${BUSINESS.phone}`,
    `Professional ${svcLower} for ${cityName} homeowners. ${BUSINESS.rating}\u2605 reviews. Fast turnaround. Call ${BUSINESS.phone} for quote`,
    `${cityName} ${svcLower} starting at ${servicePrice.replace('From ', '')}. ${BUSINESS.experience} years experience. ${BUSINESS.reviewCount}+ five-star reviews. ${BUSINESS.warranty} warranty. ${BUSINESS.phone}`,
    `Save thousands with professional ${svcLower} in ${cityName}, WA. ${BUSINESS.warranty} warranty on every project. ${BUSINESS.rating}\u2605 customer rating. Book free estimate: ${BUSINESS.phone}`,
    `${BUSINESS.name}: ${cityName}'s #1 choice for ${svcLower}. ${BUSINESS.projectsCompleted} completed projects. Licensed, bonded, insured. Call ${BUSINESS.phone}`,
    `Looking for ${svcLower} in ${cityName}? ${BUSINESS.experience} years serving WA homeowners. ${servicePrice}. ${BUSINESS.warranty} warranty. ${BUSINESS.phone}`,
    `Affordable ${svcLower} in ${cityName}, WA. ${BUSINESS.rating}\u2605 rated by ${BUSINESS.reviewCount}+ customers. Same-day estimates. ${BUSINESS.warranty} warranty included. ${BUSINESS.phone}`,
    `${cityName} homeowners trust ${BUSINESS.name} for ${svcLower}. ${servicePrice}, ${BUSINESS.warranty} warranty. ${BUSINESS.experience} years. Free quote: ${BUSINESS.phone}`,
    `Quality ${svcLower} in ${cityName}, Washington. ${BUSINESS.projectsCompleted} projects completed. Certified team with ${BUSINESS.experience} years. Call today: ${BUSINESS.phone}`,
    `Transform your home with expert ${svcLower} in ${cityName}, WA. Prices from ${servicePrice}. ${BUSINESS.rating}\u2605 rated. ${BUSINESS.warranty} warranty. ${BUSINESS.phone}`,
  ];
  const metaDescription = pickVariation(metaVariations, seed + 'meta');

  // New data: pricing, inclusions, timeline, CTA, nearby
  const multiplier = getCityMultiplier(cityId);
  const rawTiers = SERVICE_PRICING_TIERS[serviceSlug] || [];
  const pricingTiers = rawTiers.map(t => ({
    ...t,
    range: adjustPriceRange(t.range, multiplier),
  }));
  const rawInclusions = SERVICE_INCLUSIONS[serviceSlug] || [];
  const inclusions = rawInclusions.length > 0
    ? [`All ${cityName} ${service.name.toLowerCase()} projects from ${BUSINESS.name} include:`, ...rawInclusions]
    : [];
  const rawTimeline = SERVICE_TIMELINES[serviceSlug] || [];
  const cityPermit = CITY_PERMIT_NOTES[cityId] || '';
  const housingD = CITY_HOUSING_DATA[cityId];
  const timeline = rawTimeline.map((step, idx) => {
    if (idx === 0) {
      const permitSuffix = cityPermit ? ' ' + cityPermit : '';
      return { ...step, detail: step.detail.replace(/.$/, '') + ` in ${cityName}.${permitSuffix}` };
    }
    if (idx === 1) {
      const yearNote = housingD ? ` ${cityName} homes (median built ${housingD.medianYearBuilt}) often reveal outdated materials during this phase.` : '';
      return { ...step, detail: step.detail + yearNote };
    }
    if (idx === rawTimeline.length - 1) {
      return { ...step, detail: step.detail + ` Your ${cityName} project includes our ${BUSINESS.warranty} warranty.` };
    }
    return step;
  });
  const permitNote = CITY_PERMIT_NOTES[cityId] || `Permit timelines for ` + cityName + ` residential projects vary — we handle the paperwork for you.`;
  const ctaVariation = pickVariation(CTA_VARIATIONS, seed + 'cta')(cityName, service.name, BUSINESS.phone);
  const nearbyCityIds = (NEARBY_CITIES_MAP[cityId] || []).slice(0, 5);

  return {
    title,
    metaDescription,
    h1: pickVariation([
      `${service.name} in ${cityName}`,
      `${cityName} ${service.name} Experts`,
      `Professional ${service.name} in ${cityName}, WA`,
      `${service.name} for ${cityName} Homeowners`,
      `Expert ${service.name} — ${cityName}, Washington`,
      `Top-Rated ${service.name} in ${cityName}`,
      `${cityName}'s Trusted ${service.name} Contractor`,
      `Quality ${service.name} in ${cityName}, WA`,
    ], seed + 'h1'),

    heroText,
    description,
    whyChoose,
    cityContext,
    cityDataContext,

    benefits,
    problems,
    process,
    faqs,
    faqSchema,
    reviews,

    serviceName: service.name,
    serviceShortName: service.shortName,
    price: servicePrice,

    pricingTiers,
    inclusions,
    timeline,
    permitNote,
    warrantyLine: pickVariation([
      `Your ${cityName} project includes our ${BUSINESS.warranty} warranty.`,
      `All ${cityName} remodeling work comes with our ${BUSINESS.warranty} warranty.`,
      `Every ${cityName} job is backed by our ${BUSINESS.warranty} warranty.`,
      `We stand behind every ${cityName} project with a ${BUSINESS.warranty} warranty.`,
      `${cityName} homeowners get our full ${BUSINESS.warranty} warranty on all work.`,
      `Includes our comprehensive ${BUSINESS.warranty} warranty for ${cityName} clients.`,
    ], seed + 'warranty'),
    pricingDisclaimer: pickVariation([
      `Final pricing for ${cityName} projects depends on scope, materials, and site conditions.`,
      `${cityName} project costs vary based on home age, material choices, and scope of work.`,
      `Pricing for ${cityName} homes depends on existing conditions, material selections, and project complexity.`,
      `Every ${cityName} home is different \u2014 final cost depends on scope, materials, and site-specific factors.`,
      `Your ${cityName} estimate will reflect actual scope, chosen materials, and any site-specific requirements.`,
    ], seed + 'pricing'),
    ctaVariation,
    nearbyCityIds,

    // City-specific unique content
    localExpertise: CITY_REMODELING_CONTEXT[cityId] || `Our ${cityName} team brings years of local experience to every ${service.name.toLowerCase()} project. We understand the unique characteristics of homes in this area and deliver results that exceed expectations.`,
    localFacts: (() => {
      const facts = CITY_LOCAL_FACTS[cityId] || [
        `${cityName} homeowners consistently rank kitchen and bathroom remodeling as their top home improvement priority.`,
        `Professional remodeling in ${cityName} typically returns 60-70% of project cost at resale.`,
        `We've completed hundreds of projects across ${cityName} neighborhoods.`,
      ];
      const f1 = hashString(seed + 'fact0') % facts.length;
      let f2 = hashString(seed + 'fact1') % facts.length;
      if (f2 === f1) f2 = (f2 + 1) % facts.length;
      return [facts[f1], facts[f2]];
    })(),
    censusInsight: getCensusInsight(cityName, cityId, service.name),
    keywordInsight: getKeywordInsight(cityId),
    sectionOrder: (() => {
      const perms = [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
      return perms[hashString(seed + 'order') % perms.length];
    })(),
    censusData: CITY_CENSUS_DATA[cityId] || null,

    // Housing data report fields
    housingInsight: (() => {
      const hd = CITY_HOUSING_DATA[cityId];
      if (!hd) return '';
      return hd.housingInsight;
    })(),
    housingStats: (() => {
      const hd = CITY_HOUSING_DATA[cityId];
      if (!hd) return '';
      return `Built: ${hd.medianYearBuilt} | Units: ${hd.totalHousingUnits} | Owner-occupied: ${hd.ownerOccupiedPct}% | Median value: ${hd.medianHomeValue}`;
    })(),
    searchTrend: (() => {
      const hd = CITY_HOUSING_DATA[cityId];
      if (!hd || !hd.searchTrend) return null;
      return hd.searchTrend;
    })(),
    marketInsight: (() => {
      const hd = CITY_HOUSING_DATA[cityId];
      if (!hd || !hd.searchTrend) return '';
      const svcLower = service.name.toLowerCase();
      const trend = hd.searchTrend;
      const isHighSeason = trend.peakVolume > 1000;
      const timingNote = isHighSeason
        ? 'Demand is high — book early to secure your preferred start date.'
        : 'Current demand is moderate — a good time to lock in faster scheduling and competitive pricing.';
      return `Remodeling demand in ${cityName}: ${trend.peakVolume.toLocaleString()} homeowners search for ${svcLower} each ${trend.peak}. ${timingNote}`;
    })(),
  };
}

// Export list of service slugs for static generation
export const SERVICE_SLUGS = [
  'bathtub-refinishing',
  'shower-refinishing',
  'tile-refinishing',
  'sink-refinishing',
  'countertop-refinishing',
  'repair',
] as const;

export const REMODELING_SERVICE_SLUGS = [
  'bathroom-remodeling',
  'kitchen-remodeling',
  'tile-installation',
  'countertop-installation',
  'shower-installation',
  'bathtub-installation',
  'tub-to-shower',
  'cabinet-refacing',
  'walk-in-shower',
] as const;

export const ALL_SERVICE_SLUGS = [...SERVICE_SLUGS, ...REMODELING_SERVICE_SLUGS] as const;
